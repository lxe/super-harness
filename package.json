{
  "name": "super-harness",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Unified desktop super-harness multiplexing Codex, Claude Desktop, Claude tmux/remote-control, and Antigravity sessions under one chrome with a tool-equipped Master Session.",
  "homepage": "https://github.com/lxe/superharness",
  "desktopName": "super-harness.desktop",
  "author": {
    "name": "Aleksey Smolenchuk",
    "url": "https://github.com/lxe"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lxe/superharness.git"
  },
  "main": "dist/main/main/index.js",
  "bin": {
    "superharness": "dist/main/mcp/cli.js",
    "super-harness-mcp": "dist/main/mcp/server.js"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run build:main && node scripts/launch-electron.mjs .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "start": "npm run build && node scripts/launch-electron.mjs .",
    "restart": "node scripts/restart-electron.mjs",
    "restart:build": "node scripts/restart-electron.mjs --build",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o dist/storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npm run build:main && node scripts/bench-perf.mjs",
    "test:e2e": "npm run build:main && node scripts/e2e-verify.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "bonjour-service": "^1.4.4",
    "lucide-react": "^0.511.0",
    "marked": "^15.0.12",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "electron": "^36.3.2",
    "electron-builder": "^26.18.0",
    "react": "^19.1.4",
    "react-dom": "^19.1.4",
    "storybook": "^8.6.19",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
